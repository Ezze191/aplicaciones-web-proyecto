# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — FRONTEND NEXT.JS (S.I.U. Torreón Alerta)
# Copia este archivo a .env y ajusta tu configuración local.
# =============================================================================

# Puerto donde correrá el servidor Next.js (el backend usa el 3000)
PORT=3001

# IP y puerto del Backend NestJS (si cambia la IP del backend, cámbiala aquí)
NEXT_PUBLIC_BACKEND_IP=localhost
NEXT_PUBLIC_BACKEND_PORT=3000

# Google Maps JavaScript API Key (Places, Geocoding, Maps, Heatmap)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

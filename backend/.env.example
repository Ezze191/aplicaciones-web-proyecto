# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — BACKEND NESTJS (S.I.U. Torreón Alerta)
# Copia este archivo a .env y ajusta tus credenciales locales.
# =============================================================================

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Base de Datos (PostgreSQL 16 + PostGIS 3.4)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_local
DB_NAME=siu_db
DATABASE_URL=postgresql://postgres:tu_password_local@localhost:5432/siu_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# Seguridad y Autenticación JWT
JWT_SECRET=cambia_esta_clave_jwt_en_local
JWT_EXPIRES_IN=24h

# Servicios de Notificaciones y Storage
RESEND_API_KEY=re_placeholder
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
